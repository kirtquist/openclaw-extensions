{
  "id": "bible-plugin",
  "activation": {
    "onStartup": true
  },
  "name": "Bible Plugin",
  "description": "OpenClaw-native /bible slash command for devotional and study summaries.",
  "commandAliases": [
    {
      "name": "bible",
      "kind": "runtime-slash"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "provider": {
        "type": "string",
        "enum": ["openrouter", "ollama"],
        "default": "openrouter",
        "description": "Model provider. OpenRouter uses the configured API key; Ollama does not send authorization."
      },
      "baseUrl": {
        "type": "string",
        "default": "https://openrouter.ai/api/v1/chat/completions",
        "description": "OpenAI-compatible chat-completions endpoint."
      },
      "model": {
        "type": "string",
        "default": "google/gemini-2.5-flash",
        "description": "Model ID passed directly to the configured endpoint; OpenClaw aliases are not resolved."
      },
      "reasoningEffort": {
        "type": "string",
        "enum": ["none", "low", "medium", "high", "max"],
        "default": "none",
        "description": "Reasoning effort sent to direct Ollama requests. Use none to disable thinking overhead."
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 900000,
        "default": 45000,
        "description": "Maximum model request duration in milliseconds."
      },
      "signalMaxChars": {
        "type": "integer",
        "minimum": 200,
        "maximum": 4000,
        "default": 1400,
        "description": "Maximum character count for short mode replies."
      },
      "defaultMode": {
        "type": "string",
        "enum": ["short", "study", "leader", "enhanced-study"],
        "default": "study",
        "description": "Fallback response mode when no valid mode token is provided in command args."
      },
      "openrouterApiKey": {
        "type": "string",
        "description": "Direct OpenRouter API key; falls back to OPENROUTER_API_KEY and is ignored for Ollama."
      },
      "failover": {
        "type": "object",
        "additionalProperties": false,
        "description": "OpenRouter profile used when a mode opts in with modes.<mode>.failover.",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["openrouter", "ollama"]
          },
          "baseUrl": { "type": "string" },
          "model": { "type": "string" },
          "reasoningEffort": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "max"]
          },
          "requestTimeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 900000
          }
        }
      },
      "modes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Per-mode overrides of provider, endpoint, and model; optional failover flag or profile.",
        "properties": {
          "short": { "$ref": "#/$defs/modeOverride" },
          "study": { "$ref": "#/$defs/modeOverride" },
          "leader": { "$ref": "#/$defs/modeOverride" },
          "enhanced-study": { "$ref": "#/$defs/modeOverride" }
        }
      }
    },
    "$defs": {
      "modeOverride": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["openrouter", "ollama"]
          },
          "baseUrl": { "type": "string" },
          "model": { "type": "string" },
          "reasoningEffort": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "max"]
          },
          "requestTimeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 900000
          },
          "openrouterApiKey": { "type": "string" },
          "failover": {
            "description": "true uses top-level failover; false disables; object merges with top-level failover.",
            "oneOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": ["openrouter", "ollama"]
                  },
                  "baseUrl": { "type": "string" },
                  "model": { "type": "string" },
                  "reasoningEffort": {
                    "type": "string",
                    "enum": ["none", "low", "medium", "high", "max"]
                  },
                  "requestTimeoutMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 900000
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
